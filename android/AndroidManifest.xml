<?xml version="1.0" encoding="utf-8"?>
<!--
  music-edge Android 壳
  设计取舍：
    · 不用 Capacitor / TWA —— TWA 依赖 Chrome Custom Tabs，国内多数安卓机没装 Chrome 会白屏；
      Capacitor 要拉一堆 Maven 依赖，构建链路长、易断。这里是纯 WebView，零第三方依赖。
    · 允许明文流量 + 混合内容：音乐 CDN 有一部分只给 http 直链。
      网页版是 https，会被浏览器按混合内容拦掉；壳里放开这一层，直连命中率更高。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.zyplnn.musicedge"
    android:versionCode="107"
    android:versionName="1.7">
    <!--
      versionCode / versionName 是 aapt2 link 时用 version-code / version-name 参数覆盖的
      （见 build-apk.sh，值来自 src/version.js）。这里写的是兜底值：
      直接用 Android Studio 打开这个工程、或有人手敲 aapt2 时，不至于没有版本号。
      改版本请改 src/version.js，不要改这里。

      注意：XML 注释里不能出现连续两个连字符（会报 not well-formed），
      所以上面写的是不带前导连字符的参数名。
    -->

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      「下载到本地」在 Android 9 及以下要写公共下载目录，需要这两个权限。
      Android 10 起是分区存储，走 MediaStore 就不再需要它们 —— 所以用 maxSdkVersion
      限制住范围，免得在新系统上白要一个敏感权限（用户看到「存储权限」会犹豫）。
      注意这里**不是**指 READ：只写不读，读外部存储没有必要。
    -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden|uiMode|screenLayout"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 播放期前台服务 = 媒体会话宿主。
             mediaPlayback 这个类型有两个作用：Android 14 起前台服务必须声明类型；
             声明之后系统也不会因为「用户从最近任务划掉了 App」而顺手把它收掉。 -->
        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false" />
    </application>
</manifest>
